rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(company) {
      return request.auth != null && request.auth.uid != 'platform-support-francielton'
        && request.auth.token.get('isDeveloper', false) != true
        && request.auth.token.get('companyId', '') == company
        && exists(/databases/$(database)/documents/artifacts/comunica-salvador/public/data/companies/$(company)/users/$(request.auth.uid));
    }
    function support() {
      return request.auth != null && request.auth.uid == 'platform-support-francielton'
        && get(/databases/$(database)/documents/_platformSupport/$(request.auth.uid)).data.get('enabled', false) == true
        && get(/databases/$(database)/documents/_platformSupport/$(request.auth.uid)).data.get('appId', '') == 'comunica-salvador';
    }
    function admin(app, company) {
      return member(company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    function protectedUser(data, id) {
      return data.get('isDeveloper', false) == true || id == 'platform-support-francielton';
    }
    match /artifacts/{app}/public/data/companies/{company}/users/{uid} {
      allow read: if member(company) || support();
      // Profiles and private credentials must be created atomically by the server.
      allow create: if false;
      // Employee offboarding is a server transaction that also removes private credentials.
      allow delete: if false;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin']) && (support() || (
        !protectedUser(resource.data, uid) && !protectedUser(request.resource.data, uid) && (
          admin(app, company) || (member(company) && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'emergencyName', 'emergencyPhone', 'emergencyRelationship',
              'pushTokens', 'readNotifications', 'companyId', 'id'
            ])
            && request.resource.data.get('companyId', company) == company
            && request.resource.data.get('id', uid) == uid)
        )
      ));
    }

    function purchaseStageChange(before, after) {
      return before == after
        || (before == 'requested' && after in ['quotation','rejected','cancelled'])
        || (before == 'approved' && after in ['ordered','cancelled'])
        || (before == 'quotation' && after in ['approved','rejected','cancelled'])
        || (before == 'ordered' && after in ['in_transit','received','exception','cancelled'])
        || (before == 'in_transit' && after in ['received','exception','cancelled'])
        || (before == 'received' && after in ['stored','exception'])
        || (before == 'exception' && after in ['received','cancelled'])
        || (before == 'stored' && after == 'delivered')
        || (before == 'delivered' && after == 'closed');
    }
    function validPurchase(data) {
      return data.keys().hasOnly(['item','specification','quantity','unit','department','destination','neededBy','reason','priority',
        'supplier','quotedPrice','orderNumber','expectedDate','carrier','trackingCode','invoiceNumber','receivedQuantity',
        'condition','lot','expiresAt','storageAddress','destinationRecipient','note','status','requesterId','requesterName',
        'createdAt','updatedAt','updatedBy','history','workflowVersion','participantIds',
        'buyerId','approverId','receiverId','recipientId','financeId',
        'approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt',
        'invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt'])
        && data.get('item','') is string && data.item.size() > 0 && data.item.size() <= 160
        && data.get('specification','') is string && data.specification.size() > 0 && data.specification.size() <= 1000
        && data.get('quantity',0) is number && data.quantity > 0 && data.quantity <= 1000000
        && data.get('unit','') is string && data.unit.size() > 0 && data.unit.size() <= 30
        && data.get('department','') is string && data.department.size() > 0 && data.department.size() <= 120
        && data.get('destination','') is string && data.destination.size() > 0 && data.destination.size() <= 160
        && data.get('reason','') is string && data.reason.size() > 0 && data.reason.size() <= 1000
        && data.get('neededBy','') is string && data.neededBy.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.get('requesterId','') is string && data.requesterId.size() > 0
        && data.get('requesterName','') is string && data.requesterName.size() > 0
        && data.get('status','') in ['requested','approved','quotation','ordered','in_transit','received','exception','stored','delivered','closed','rejected','cancelled']
        && data.get('createdAt',0) is int && data.get('updatedAt',0) is int
        && data.get('updatedBy','') is string
        && data.get('history',[]) is list && data.history.size() > 0 && data.history.size() <= 50
        && data.get('quotedPrice',0) is number && data.quotedPrice >= 0
        && data.get('receivedQuantity',0) is number && data.receivedQuantity >= 0 && data.receivedQuantity <= data.quantity
        && data.get('condition','pending') in ['pending','ok','damaged']
        && data.get('workflowVersion',0) is int && data.get('workflowVersion',0) in [0,2]
        && data.get('participantIds',[]) is list && data.get('participantIds',[]).size() <= 10
        && (data.get('workflowVersion',0) != 2 || (data.requesterId in data.participantIds
          && (data.get('buyerId','') == '' || data.buyerId in data.participantIds)
          && (data.get('approverId','') == '' || data.approverId in data.participantIds)
          && (data.get('receiverId','') == '' || data.receiverId in data.participantIds)
          && (data.get('recipientId','') == '' || data.recipientId in data.participantIds)
          && (data.get('financeId','') == '' || data.financeId in data.participantIds)))
        && data.get('buyerId','') is string && data.get('approverId','') is string
        && data.get('receiverId','') is string && data.get('recipientId','') is string && data.get('financeId','') is string
        && data.get('approvedBy','') is string && data.get('approvedAt',0) is int
        && data.get('buyerConfirmedBy','') is string && data.get('buyerConfirmedAt',0) is int
        && data.get('receiverConfirmedBy','') is string && data.get('receiverConfirmedAt',0) is int
        && data.get('invoiceReceivedBy','') is string && data.get('invoiceReceivedAt',0) is int
        && data.get('recipientConfirmedBy','') is string && data.get('recipientConfirmedAt',0) is int
        && data.get('financeConfirmedBy','') is string && data.get('financeConfirmedAt',0) is int;
    }
    function validPurchaseStage(data) {
      return (!(data.status in ['approved','ordered','in_transit','received','exception','stored','delivered','closed'])
          || (data.get('supplier','') is string && data.supplier.size() > 0
            && data.get('expectedDate','') is string && data.expectedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}') && data.quotedPrice > 0))
        && (!(data.status in ['ordered','in_transit','received','exception','stored','delivered','closed']) || (data.get('orderNumber','') is string && data.orderNumber.size() > 0))
        && (!(data.status in ['received','exception','stored','delivered','closed'])
          || (data.get('invoiceNumber','') is string && data.invoiceNumber.size() > 0
            && data.receivedQuantity > 0 && data.condition != 'pending'))
        && (data.status != 'received' || (data.receivedQuantity == data.quantity && data.condition == 'ok'))
        && (data.status != 'exception' || (data.receivedQuantity < data.quantity || data.condition == 'damaged'))
        && (!(data.status in ['stored','delivered','closed'])
          || (data.receivedQuantity == data.quantity && data.condition == 'ok'
            && data.get('storageAddress','') is string && data.storageAddress.size() > 0))
        && (!(data.status in ['delivered','closed'])
          || (data.get('destinationRecipient','') is string && data.destinationRecipient.size() > 0))
        && (data.get('workflowVersion',0) != 2 || (
          (data.status in ['requested','rejected','cancelled'] || data.get('buyerId','') != '')
          && (data.status in ['requested','quotation','rejected','cancelled']
            || (data.get('approverId','') != '' && data.get('approvedBy','') == data.approverId && data.get('approvedAt',0) > 0))
          && (data.status in ['requested','quotation','approved','rejected','cancelled']
            || (data.get('buyerConfirmedBy','') == data.buyerId && data.get('buyerConfirmedAt',0) > 0))
          && (data.status in ['requested','quotation','approved','ordered','in_transit','rejected','cancelled']
            || (data.get('receiverId','') != '' && data.get('receiverConfirmedBy','') == data.receiverId
              && data.get('receiverConfirmedAt',0) > 0 && data.get('invoiceReceivedBy','') == data.receiverId && data.get('invoiceReceivedAt',0) > 0))
          && (data.status in ['requested','quotation','approved','ordered','in_transit','received','exception','stored','rejected','cancelled']
            || (data.get('recipientId','') != '' && data.get('recipientConfirmedBy','') == data.recipientId && data.get('recipientConfirmedAt',0) > 0))
          && (data.status != 'closed' || (data.get('financeId','') != '' && data.get('financeConfirmedBy','') == data.financeId && data.get('financeConfirmedAt',0) > 0))
        ));
    }
    function purchaseAuthority(app, company, data) {
      return exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.get('enabled', false) == true
        ? data.approverId == (data.quotedPrice * data.quantity <= get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.threshold
          ? get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.lowerApproverId
          : get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.upperApproverId)
        : (exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(data.approverId))
          && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(data.approverId)).data.get('isAdmin', false) == true);
    }
    function purchaseAction(app, company, before, after) {
      let changed = after.diff(before).affectedKeys();
      let actor = request.auth.uid;
      return before.status == after.status
        ? ((manages(app, company) && (before.status != 'closed' || changed.hasOnly(['note','updatedAt','updatedBy','history']))
          && (before.get('approvedAt',0) == 0 || !changed.hasAny(['supplier','quotedPrice','expectedDate']))
          && (before.get('buyerConfirmedAt',0) == 0 || !changed.hasAny(['orderNumber']))
          && (before.get('invoiceReceivedAt',0) == 0 || !changed.hasAny(['invoiceNumber']))
          && !changed.hasAny(['approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt','invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt']))
          || (actor == before.get('buyerId','') && actor != '' && before.status in ['requested','quotation','approved','ordered','in_transit']
            && (before.get('approvedAt',0) == 0 || !changed.hasAny(['supplier','quotedPrice','orderNumber','expectedDate']))
            && changed.hasOnly(['supplier','quotedPrice','orderNumber','expectedDate','carrier','trackingCode','note','updatedAt','updatedBy','history']))
          || (actor == before.get('receiverId','') && actor != '' && before.status in ['ordered','in_transit','received','exception']
            && (before.get('invoiceReceivedAt',0) == 0 || !changed.hasAny(['invoiceNumber']))
            && changed.hasOnly(['invoiceNumber','receivedQuantity','condition','lot','expiresAt','storageAddress','note','updatedAt','updatedBy','history'])))
        : (!changed.hasAny(['buyerId','approverId','receiverId','recipientId','financeId','participantIds'])
          && ((after.status in ['rejected','cancelled'] && manages(app, company) && changed.hasOnly(['status','note','updatedAt','updatedBy','history']))
            || (after.status == 'quotation' && actor == before.get('buyerId','') && actor != '' && changed.hasOnly(['status','updatedAt','updatedBy','history','supplier','quotedPrice','orderNumber','expectedDate','carrier','trackingCode','note']))
            || (after.status == 'approved' && actor == before.get('approverId','') && actor != '' && purchaseAuthority(app, company, after)
              && after.get('approvedBy','') == actor && after.get('approvedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','approvedBy','approvedAt']))
            || (after.status == 'ordered' && actor == before.get('buyerId','') && actor != '' && before.get('approvedAt',0) > 0
              && after.get('buyerConfirmedBy','') == actor && after.get('buyerConfirmedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','orderNumber','carrier','trackingCode','note','buyerConfirmedBy','buyerConfirmedAt']))
            || (after.status == 'in_transit' && actor == before.get('buyerId','') && actor != ''
              && changed.hasOnly(['status','updatedAt','updatedBy','history','carrier','trackingCode','note']))
            || (after.status in ['received','exception'] && actor == before.get('receiverId','') && actor != ''
              && after.get('receiverConfirmedBy','') == actor && after.get('receiverConfirmedAt',0) == after.updatedAt
              && after.get('invoiceReceivedBy','') == actor && after.get('invoiceReceivedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','invoiceNumber','receivedQuantity','condition','lot','expiresAt','storageAddress','note','receiverConfirmedBy','receiverConfirmedAt','invoiceReceivedBy','invoiceReceivedAt']))
            || (after.status == 'stored' && actor == before.get('receiverId','') && actor != ''
              && changed.hasOnly(['status','updatedAt','updatedBy','history','storageAddress','lot','expiresAt','note']))
            || (after.status == 'delivered' && actor == before.get('recipientId','') && actor != ''
              && after.get('recipientConfirmedBy','') == actor && after.get('recipientConfirmedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','destinationRecipient','recipientConfirmedBy','recipientConfirmedAt']))
            || (after.status == 'closed' && actor == before.get('financeId','') && actor != ''
              && after.get('financeConfirmedBy','') == actor && after.get('financeConfirmedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','financeConfirmedBy','financeConfirmedAt']))));
    }
    function integraEnabled(app, company) {
      return exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/integra-access)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/integra-access).data.get('enabled', false) == true;
    }
    function access(company) { return member(company) || support(); }
    // Casos e limites de envio são acessíveis somente pelo Admin SDK no servidor.
    match /_privateWhistleblowing/{document=**} { allow read, write: if false; }
    match /_privateWhistleblowingRateLimits/{document=**} { allow read, write: if false; }
    match /_platformSalesRateLimits/{document=**} { allow read, write: if false; }
    match /_platformSalesLeads/{leadId} {
      allow read: if support();
      allow create, delete: if false;
      allow update: if support()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'contactedAt', 'contactedBy'])
        && request.resource.data.get('status', '') in ['new', 'contacted', 'converted', 'discarded'];
    }
    function manages(app, company) { return admin(app, company) || support(); }
    function canEdit(app, company) {
      return manages(app, company) || (member(company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('permissions', {}).get('canEdit', true) == true);
    }
    function canManageCalendar(app, company) {
      return manages(app, company) || (member(company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('permissions', {}).get('canManageCalendar', true) == true);
    }
    function canManageScheduleRules(app, company) {
      return manages(app, company) || (member(company)
        && canManageCalendar(app, company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('permissions', {}).get('canManageScheduleRules', true) == true);
    }
    function canManageActivities(app, company) {
      return manages(app, company) || (member(company)
        && canEdit(app, company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('permissions', {}).get('canManageActivities', true) == true);
    }
    function canManageActivityTemplates(app, company) {
      return manages(app, company) || (member(company)
        && canManageActivities(app, company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('permissions', {}).get('canManageActivityTemplates', false) == true);
    }
    function canPublishAbsenceForOthers(app, company) {
      return member(company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('permissions', {}).get('canPublishAbsenceForOthers', false) == true;
    }
    function ownsAuditEntry() {
      return request.resource.data.get('actorId', '') == request.auth.uid
        && request.resource.data.get('timestamp', 0) is int
        && request.resource.data.get('action', '') is string;
    }
    function careerManager(app, company) {
      let profile = get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data;
      let role = profile.get('role', '').lower();
      let department = profile.get('department', '').lower();
      let dept = profile.get('dept', '').lower();
      let departments = profile.get('departments', []);
      let depts = profile.get('depts', []);
      return admin(app, company) || (member(company) && (
        role == 'rh' || role.matches('.*recursos humanos.*') || role.matches('.*rh.*')
        || department == 'rh' || department.matches('.*recursos humanos.*') || department.matches('.*rh.*')
        || dept == 'rh' || dept.matches('.*recursos humanos.*') || dept.matches('.*rh.*')
        || 'RH' in departments || 'rh' in departments || 'Recursos Humanos' in departments
        || 'RH' in depts || 'rh' in depts || 'Recursos Humanos' in depts
      ));
    }
    function participant(data) {
      return request.auth.uid in data.get('participants', [])
        || data.get('senderId', '') == request.auth.uid || data.get('receiverId', '') == request.auth.uid;
    }
    function addsOwnRead() {
      let before = resource.data.get('readBy', []);
      let after = request.resource.data.get('readBy', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && before is list && after is list
        && !(request.auth.uid in before)
        && after == before.concat([request.auth.uid]);
    }
    function addsOwnVote() {
      let before = resource.data.get('votes', {});
      let after = request.resource.data.get('votes', {});
      let option = after.get(request.auth.uid, -1);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && before is map && after is map
        && !(request.auth.uid in before)
        && after.diff(before).addedKeys().hasAll([request.auth.uid])
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && option is int && option >= 0
        && option < resource.data.get('options', []).size();
    }
    function productionManager(app, company) {
      return manages(app, company) || (member(company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('role', '').lower().matches('.*(encarregado.*produ|produ.*encarregado).*'));
    }
    function scheduleManager(app, company) {
      let role = get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('role', '').lower();
      return manages(app, company) || (member(company)
        && role.matches('.*(coordenador|encarregado|supervis|diretor|gestor|gest[aã]o|rh).*'));
    }
    function scheduleDepartmentInScope(app, company, data) {
      let profile = get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data;
      let department = data.get('dept', '');
      return manages(app, company) || (member(company) && department != '' && (
        department == profile.get('dept', '') || department == profile.get('department', '')
        || department in profile.get('depts', []) || department in profile.get('departments', [])
      ));
    }
    function scheduleDraftInScope(app, company, data) {
      let profile = get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data;
      let allowed = profile.get('depts', []).concat(profile.get('departments', [])).concat([profile.get('dept', ''), profile.get('department', '')]);
      return manages(app, company) || (member(company) && data.get('departmentIds', []).size() > 0 && data.get('departmentIds', []).hasOnly(allowed));
    }
    function validScheduleDraft(data) {
      return data.keys().hasOnly(['revision', 'updatedAt', 'startDate', 'endDate', 'partCount', 'encoding', 'departmentIds'])
        && data.revision is string && data.revision.size() <= 80
        && data.updatedAt is int && data.startDate is string && data.endDate is string
        && data.partCount is int && data.partCount >= 1 && data.partCount <= 100
        && data.encoding in ['json', 'gzip-base64'] && data.departmentIds is list && data.departmentIds.size() <= 500;
    }
    function absencePostOwner(app, company, id) {
      return id.matches('post-abs-.+') && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/absences/$(id.replace('^post-abs-', ''))).data.get('userId', '') == request.auth.uid;
    }
    function absencePostOwnerAfter(app, company, id) {
      let absence = getAfter(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/absences/$(id.replace('^post-abs-', ''))).data;
      return id.matches('post-abs-.+') && (absence.get('userId', '') == request.auth.uid
        || (absence.get('createdBy', '') == request.auth.uid
          && (scheduleManager(app, company) || canPublishAbsenceForOthers(app, company))));
    }
    function productionWorker(app, company) {
      return productionManager(app, company) || (member(company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('prodGroup', '') != '');
    }
    function documentAudience(app, company, data) {
      return manages(app, company) || (member(company) && (
        data.get('accessMode', 'company') == 'company'
        || (data.get('accessMode', 'company') == 'people' && request.auth.uid in data.get('allowedUserIds', []))
        || (data.get('accessMode', 'company') == 'department' && data.get('dept', '') in get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('depts', []))
      ));
    }
    match /artifacts/{app}/public/data/platformUpdates/{updateId} {
      allow read: if support() || (request.auth != null
        && member(request.auth.token.get('companyId', ''))
        && (resource.data.get('targetCompanies', []).size() == 0
          || request.auth.token.get('companyId', '') in resource.data.get('targetCompanies', [])));
      allow create, update, delete: if support();
    }
    match /artifacts/{app}/public/data/platformUpdateReads/{uid}/updates/{updateId} {
      allow read: if support() || (request.auth != null && request.auth.uid == uid
        && member(request.auth.token.get('companyId', '')));
      allow create: if request.auth != null && request.auth.uid == uid
        && member(request.auth.token.get('companyId', ''))
        && request.resource.data.get('userId', '') == uid
        && request.resource.data.get('updateId', '') == updateId
        && request.resource.data.get('readAt', 0) is int;
      allow update, delete: if false;
    }
    match /artifacts/{app}/public/data/companies/{company} {
      allow read: if access(company);
      allow write: if false;
      match /settings/integra-access {
        allow get: if access(company);
        allow list: if false;
        allow create, update: if support()
          && request.resource.data.keys().hasOnly(['enabled', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['enabled', 'updatedAt', 'updatedBy'])
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /settings/purchase-approval {
        allow get: if access(company);
        allow list: if false;
        allow create, update: if manages(app, company)
          && request.resource.data.keys().hasOnly(['enabled','threshold','lowerApproverId','upperApproverId','updatedAt','updatedBy'])
          && request.resource.data.keys().hasAll(['enabled','threshold','lowerApproverId','upperApproverId','updatedAt','updatedBy'])
          && request.resource.data.enabled is bool
          && request.resource.data.threshold is number && request.resource.data.threshold > 0
          && request.resource.data.lowerApproverId is string && request.resource.data.upperApproverId is string
          && (!request.resource.data.enabled || (request.resource.data.lowerApproverId.size() > 0 && request.resource.data.upperApproverId.size() > 0))
          && request.resource.data.updatedAt is int && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /purchaseRequests/{id} {
        allow get, list: if support() || (integraEnabled(app, company) && (admin(app, company) || (member(company) && (resource.data.get('requesterId','') == request.auth.uid || request.auth.uid in resource.data.get('participantIds',[])))));
        allow create: if member(company) && integraEnabled(app, company) && validPurchase(request.resource.data) && validPurchaseStage(request.resource.data)
          && request.resource.data.status == 'requested' && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.workflowVersion == 2 && request.resource.data.participantIds == [request.auth.uid]
          && request.resource.data.buyerId == '' && request.resource.data.approverId == '' && request.resource.data.receiverId == ''
          && request.resource.data.recipientId == '' && request.resource.data.financeId == ''
          && !request.resource.data.keys().hasAny(['approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt','invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.resource.data.updatedAt
          && request.resource.data.history.size() == 1
          && request.resource.data.history[0].get('by','') == request.auth.uid
          && request.resource.data.history[0].get('stage','') == 'requested';
        allow update: if manages(app, company) && (support() || integraEnabled(app, company))
          && resource.data.get('workflowVersion',0) == 0
          && resource.data.status in ['requested','approved','quotation','ordered','in_transit','received','exception','stored','delivered']
          && request.resource.data.get('workflowVersion',0) == 2 && request.resource.data.status == 'requested'
          && validPurchase(request.resource.data) && validPurchaseStage(request.resource.data)
          && request.resource.data.participantIds == [resource.data.requesterId]
          && request.resource.data.buyerId == '' && request.resource.data.approverId == ''
          && request.resource.data.receiverId == '' && request.resource.data.recipientId == '' && request.resource.data.financeId == ''
          && !request.resource.data.keys().hasAny(['approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt','invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflowVersion','status','participantIds','buyerId','approverId','receiverId','recipientId','financeId','updatedAt','updatedBy','history'])
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt > resource.data.updatedAt
          && request.resource.data.history[request.resource.data.history.size() - 1].get('by','') == request.auth.uid
          && request.resource.data.history[request.resource.data.history.size() - 1].get('stage','') == 'requested';
        allow update: if (support() || (member(company) && integraEnabled(app, company)))
          && validPurchase(request.resource.data) && validPurchaseStage(request.resource.data)
          && request.resource.data.get('workflowVersion',0) == 2
          && purchaseStageChange(resource.data.get('status',''), request.resource.data.status)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'supplier','quotedPrice','orderNumber','expectedDate','carrier','trackingCode','invoiceNumber','receivedQuantity',
            'condition','lot','expiresAt','storageAddress','destinationRecipient','note','status','updatedAt','updatedBy','history',
            'buyerId','approverId','receiverId','recipientId','financeId','participantIds',
            'approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt',
            'invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt'])
          && purchaseAction(app, company, resource.data, request.resource.data)
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt > resource.data.updatedAt
          && request.resource.data.history.size() > 0
          && request.resource.data.history[request.resource.data.history.size() - 1].get('by','') == request.auth.uid
          && request.resource.data.history[request.resource.data.history.size() - 1].get('stage','') == request.resource.data.status;
        allow delete: if false;
      }
      match /users/{uid}/scheduleDrafts/{draftId} {
        function ownsDraft() { return request.auth != null && request.auth.uid == uid && scheduleManager(app, company) && canManageCalendar(app, company); }
        function canReadDraft() { return ownsDraft() || (request.auth != null && manages(app, company)); }
        allow read: if canReadDraft();
        allow create: if ownsDraft() && validScheduleDraft(request.resource.data) && scheduleDraftInScope(app, company, request.resource.data);
        allow update: if ownsDraft() && validScheduleDraft(request.resource.data) && scheduleDraftInScope(app, company, resource.data) && scheduleDraftInScope(app, company, request.resource.data);
        allow delete: if false;
        match /parts/{partId} {
          allow read: if canReadDraft()
            && scheduleDraftInScope(app, company, get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(uid)/scheduleDrafts/$(draftId)).data)
            && resource.data.revision == get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(uid)/scheduleDrafts/$(draftId)).data.revision;
          allow create, update: if ownsDraft()
            && scheduleDraftInScope(app, company, getAfter(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(uid)/scheduleDrafts/$(draftId)).data)
            && request.resource.data.keys().hasOnly(['revision', 'payload']) && request.resource.data.payload is string && request.resource.data.payload.size() <= 600000
            && request.resource.data.revision == getAfter(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(uid)/scheduleDrafts/$(draftId)).data.revision;
          allow delete: if ownsDraft() && scheduleDraftInScope(app, company, getAfter(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(uid)/scheduleDrafts/$(draftId)).data);
        }
      }
      match /{kind}/{id} {
        allow read: if kind in ['departments', 'roles', 'announcements', 'posts', 'polls', 'events', 'absences', 'presence', 'settings', 'vacancies', 'activities', 'activityTemplates'] && access(company);
        allow read: if kind == 'schedules' && access(company) && scheduleDepartmentInScope(app, company, resource.data);
        allow read: if kind == 'scheduleSwapRequests' && access(company) && ((scheduleManager(app, company) && canManageCalendar(app, company))
          || resource.data.get('requesterId', '') == request.auth.uid || resource.data.get('targetUserId', '') == request.auth.uid);
        allow read: if kind == 'documents' && documentAudience(app, company, resource.data);
        allow read: if kind == 'applications' && (support() || careerManager(app, company));
        allow write: if kind in ['departments', 'roles', 'settings', 'events', 'presence'] && manages(app, company) && !(kind == 'settings' && id in ['integra-access','purchase-approval']) && !(kind == 'settings' && id == 'schedule-rules' && request.method == 'delete');
        allow create, update: if kind == 'presence' && access(company) && (
          (scheduleManager(app, company) && canManageCalendar(app, company))
          || (canPublishAbsenceForOthers(app, company) && request.resource.data.get('status', '') == 'Férias'
            && exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.resource.data.get('userId', '')))));
        allow write: if kind == 'settings' && id == 'whistleblowing-poster' && member(company)
          && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('permissions', {}).get('tabs', {}).get('whistleblowing', false) == true;
        allow create, update: if kind == 'settings' && id == 'schedule-rules'
          && scheduleManager(app, company) && canManageScheduleRules(app, company) && canEdit(app, company)
          && (manages(app, company) || (exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/$(id))
            && request.resource.data.get('coverageRequirements', []) == resource.data.get('coverageRequirements', [])));
        allow create: if kind == 'schedules' && scheduleManager(app, company) && canManageCalendar(app, company) && canEdit(app, company)
          && scheduleDepartmentInScope(app, company, request.resource.data);
        allow update: if kind == 'schedules' && scheduleManager(app, company) && canManageCalendar(app, company) && canEdit(app, company)
          && scheduleDepartmentInScope(app, company, resource.data) && scheduleDepartmentInScope(app, company, request.resource.data);
        allow delete: if kind == 'schedules' && scheduleManager(app, company) && canManageCalendar(app, company) && canEdit(app, company)
          && scheduleDepartmentInScope(app, company, resource.data);
        allow create: if kind == 'scheduleSwapRequests' && member(company)
          && request.resource.data.keys().hasOnly(['requesterId', 'requesterName', 'sourceScheduleId', 'sourceDate', 'targetUserId', 'targetName', 'targetScheduleId', 'targetDate', 'reason', 'status', 'scheduleSignature', 'createdAt', 'updatedAt'])
          && request.resource.data.get('requesterId', '') == request.auth.uid
          && request.resource.data.get('targetUserId', '') != request.auth.uid
          && request.resource.data.get('status', '') == 'pending_peer'
          && request.resource.data.get('createdAt', 0) is int && request.resource.data.get('updatedAt', 0) == request.resource.data.get('createdAt', 0)
          && request.resource.data.get('reason', '') is string && request.resource.data.get('reason', '').size() <= 240
          && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/schedules/$(request.resource.data.get('sourceScheduleId', ''))).data.get('userId', '') == request.auth.uid
          && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/schedules/$(request.resource.data.get('targetScheduleId', ''))).data.get('userId', '') == request.resource.data.get('targetUserId', '')
          && request.resource.data.get('sourceDate', '') >= get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/schedules/$(request.resource.data.get('sourceScheduleId', ''))).data.get('startDate', '')
          && request.resource.data.get('sourceDate', '') <= get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/schedules/$(request.resource.data.get('sourceScheduleId', ''))).data.get('endDate', '')
          && request.resource.data.get('targetDate', '') >= get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/schedules/$(request.resource.data.get('targetScheduleId', ''))).data.get('startDate', '')
          && request.resource.data.get('targetDate', '') <= get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/schedules/$(request.resource.data.get('targetScheduleId', ''))).data.get('endDate', '');
        allow update: if kind == 'scheduleSwapRequests' && access(company) && (
          (resource.data.get('status', '') == 'pending_peer' && resource.data.get('targetUserId', '') == request.auth.uid
            && request.resource.data.get('status', '') in ['pending_manager', 'rejected']
            && request.resource.data.get('peerRespondedById', '') == request.auth.uid && request.resource.data.get('updatedAt', 0) is int
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'peerRespondedAt', 'peerRespondedById', 'peerRespondedByName', 'decisionNote']))
          || (resource.data.get('status', '') in ['pending_peer', 'pending_manager'] && resource.data.get('requesterId', '') == request.auth.uid
            && request.resource.data.get('status', '') == 'cancelled'
            && request.resource.data.get('cancelledById', '') == request.auth.uid && request.resource.data.get('updatedAt', 0) is int
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt', 'cancelledById']))
          || (resource.data.get('status', '') == 'pending_manager' && scheduleManager(app, company) && canManageCalendar(app, company)
            && request.resource.data.get('status', '') in ['approved', 'rejected']
            && request.resource.data.get('reviewedById', '') == request.auth.uid && request.resource.data.get('updatedAt', 0) is int
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'reviewedAt', 'reviewedById', 'reviewedByName', 'decisionNote']))
        );
        allow delete: if kind == 'scheduleSwapRequests' && false;
        allow create, update, delete: if kind == 'activities' && canManageActivities(app, company);
        allow create, update, delete: if kind == 'activityTemplates' && canManageActivityTemplates(app, company);
        allow create, update, delete: if kind == 'vacancies' && (support() || careerManager(app, company));
        allow update: if kind == 'applications' && (support() || careerManager(app, company))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNotes', 'recruitmentUpdate', 'decisionAt', 'decisionBy', 'discardReason', 'interview', 'interviewScheduledAt', 'interviewScheduledBy', 'candidateUpdatePending', 'candidateUpdateAcknowledgedAt', 'aiAssessment', 'aiAssessmentAt', 'aiAssessmentBy', 'aiAssessmentVacancyUpdatedAt'])
          && request.resource.data.get('status', '') in ['received', 'reviewing', 'preselected', 'interview', 'rejected', 'hired', 'closed'];
        allow create, delete: if kind in ['announcements', 'documents', 'polls'] && manages(app, company);
        allow update: if kind == 'announcements' && access(company) && (
          (manages(app, company) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy']))
          || addsOwnRead()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'comments']));
        allow update: if kind == 'documents' && documentAudience(app, company, resource.data) && (
          (manages(app, company) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy']))
          || (resource.data.get('requiredRead', false) == true && addsOwnRead()));
        allow update: if kind == 'polls' && access(company) && (
          (manages(app, company) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['votes']))
          || addsOwnVote());
        allow create: if kind == 'posts' && access(company) && ((canEdit(app, company) && (manages(app, company) || request.resource.data.get('authorId', '') == request.auth.uid)) || (request.resource.data.get('authorId', '') == 'system' && absencePostOwnerAfter(app, company, id)));
        allow update: if kind == 'posts' && access(company) && (manages(app, company)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'comments']));
        allow delete: if kind == 'posts' && access(company) && canEdit(app, company) && (manages(app, company) || resource.data.get('authorId', '') == request.auth.uid || absencePostOwner(app, company, id));
        allow create: if kind == 'absences' && access(company) && (manages(app, company) || (request.resource.data.get('userId', '') == request.auth.uid && canManageCalendar(app, company)) || (request.resource.data.get('createdBy', '') == request.auth.uid && ((scheduleManager(app, company) && canManageCalendar(app, company)) || canPublishAbsenceForOthers(app, company))));
        allow update, delete: if kind == 'absences' && access(company) && canManageCalendar(app, company) && (manages(app, company) || resource.data.get('userId', '') == request.auth.uid);
      }
      match /messages/{id} {
        allow read: if support()
          || (manages(app, company) && (resource.data.get('serviceRequest', false) == true
            || resource.data.get('activity', {}).get('status', '') in ['pending', 'in_progress', 'resolved']))
          || (member(company) && participant(resource.data));
        allow create: if access(company) && participant(request.resource.data)
          && request.resource.data.get('senderId', '') in [request.auth.uid, 'system'];
        allow update: if access(company) && participant(resource.data) && participant(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy', 'archivedBy', 'pinnedBy', 'mutedBy', 'participants', 'threadId', 'subject', 'dueDate', 'initialDueDate', 'dueDateHistory', 'completedAt', 'completedBy', 'resolutionRating', 'resolutionFeedback', 'resolutionEvaluatedAt', 'servicePriority', 'servicePriorityLabel', 'serviceDecision', 'serviceDecisionBy', 'serviceDecisionAt', 'serviceStatus', 'serviceAssigneeId', 'serviceAssigneeName', 'serviceStartedAt', 'serviceWaitingSince', 'servicePromisedDate', 'serviceProgress', 'serviceProgressNote', 'serviceProgressUpdatedAt', 'serviceProgressUpdatedBy', 'likedBy', 'savedBy', 'highlightedBy', 'activity'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activity']) || canManageActivities(app, company));
        allow delete: if false;
      }
      match /scheduleCoverageApprovals/{id} {
        allow read: if manages(app, company);
        allow create: if manages(app, company)
          && request.resource.data.keys().hasOnly(['publicationId', 'actorId', 'actorName', 'reason', 'snapshotHash', 'rulesVersion', 'gaps', 'departmentIds', 'startDate', 'endDate', 'approvedAt'])
          && request.resource.data.publicationId == id && request.resource.data.actorId == request.auth.uid
          && request.resource.data.approvedAt == request.time
          && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1000
          && request.resource.data.gaps is list && request.resource.data.gaps.size() > 0 && request.resource.data.gaps.size() <= 5000
          && request.resource.data.actorName is string && request.resource.data.snapshotHash is string
          && request.resource.data.rulesVersion is number && request.resource.data.departmentIds is list
          && request.resource.data.startDate is string && request.resource.data.endDate is string;
        allow update, delete: if false;
      }
      match /auditLogs/{id} {
        allow read: if manages(app, company);
        allow create: if access(company) && ownsAuditEntry();
        allow update, delete: if false;
      }
      match /productivity/{id} {
        allow read: if productionWorker(app, company);
        allow create: if canEdit(app, company) && (productionManager(app, company) || (productionWorker(app, company)
          && request.resource.data.get('authorId', '') == request.auth.uid
          && request.resource.data.get('group', '') == get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('prodGroup', '')));
        allow update, delete: if productionManager(app, company);
      }
    }
    // Regras ativas: validar no emulador antes de cada alteracao publicada.
  }
}

