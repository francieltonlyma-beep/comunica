rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(company) {
      return request.auth != null && request.auth.uid != 'platform-support-francielton'
        && request.auth.token.get('isDeveloper', false) != true
        && request.auth.token.get('companyId', '') == company
        && get(/databases/$(database)/documents/artifacts/comunica-salvador/public/data/companies/$(company)).data.get('codeBlocked', false) != true
        && exists(/databases/$(database)/documents/artifacts/comunica-salvador/public/data/companies/$(company)/users/$(request.auth.uid));
    }
    function support() {
      return request.auth != null && request.auth.uid == 'platform-support-francielton'
        && get(/databases/$(database)/documents/_platformSupport/$(request.auth.uid)).data.get('enabled', false) == true
        && get(/databases/$(database)/documents/_platformSupport/$(request.auth.uid)).data.get('appId', '') == 'comunica-salvador';
    }
    function admin(app, company) {
      return member(company)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    function purchaseRoleAllowed(app, company, field, uid) {
      return !exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval)
        || get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.get(field, []).size() == 0
        || uid in get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.get(field, []);
    }
    function protectedUser(data, id) {
      return data.get('isDeveloper', false) == true || id == 'platform-support-francielton';
    }
    match /artifacts/{app}/public/data/companies/{company}/users/{uid} {
      allow read: if support() || admin(app, company) || (member(company) && request.auth.uid == uid);
      // Profiles and private credentials must be created atomically by the server.
      allow create: if false;
      // Employee offboarding is a server transaction that also removes private credentials.
      allow delete: if false;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin']) && (support() || (
        !protectedUser(resource.data, uid) && !protectedUser(request.resource.data, uid) && (
          admin(app, company) || (member(company) && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'emergencyName', 'emergencyPhone', 'emergencyRelationship',
              'pushTokens', 'readNotifications', 'companyId', 'id'
            ])
            && request.resource.data.get('companyId', company) == company
            && request.resource.data.get('id', uid) == uid)
        )
      ));
    }

    match /artifacts/{app}/public/data/companies/{company}/userDirectory/{uid} {
      allow read: if member(company) || support();
      allow create, update: if admin(app, company) && request.resource.data.id == uid
        && request.resource.data.keys().hasOnly(['id','name','role','avatar','depts','dept','department',
          'prodGroup','managerId','isAdmin','isEmployee','birthMonthDay']);
      allow delete: if false;
    }

    function purchaseStageChange(before, after) {
      return before == after
        || (before == 'requested' && after in ['quotation','rejected','cancelled'])
        || (before == 'approved' && after in ['ordered','cancelled'])
        || (before == 'quotation' && after in ['approved','rejected','cancelled'])
        || (before == 'ordered' && after in ['in_transit','received','exception','cancelled'])
        || (before == 'in_transit' && after in ['received','exception','cancelled'])
        || (before == 'received' && after in ['stored','exception'])
        || (before == 'exception' && after in ['received','cancelled'])
        || (before == 'stored' && after == 'delivered')
        || (before == 'delivered' && after in ['closed','finance_dispute'])
        || (before == 'finance_dispute' && after == 'delivered')
        || (before == 'rejected' && after in ['requested','quotation']);
    }
    function validPurchase(data) {
      return data.keys().hasOnly(['category','item','specification','quantity','unit','department','destination','neededBy','reason','priority',
        'supplier','quotedPrice','orderNumber','expectedDate','carrier','trackingCode','invoiceNumber','invoiceTotal','receivedQuantity',
        'condition','lot','expiresAt','storageAddress','destinationRecipient','note','status','requesterId','requesterName',
        'createdAt','updatedAt','updatedBy','history','workflowVersion','participantIds',
        'buyerId','approverId','receiverId','recipientId','financeId',
        'approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt',
        'invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt',
        'financeIssue','financeIssueBy','financeIssueAt','financeResolution','financeResolutionBy','financeResolutionAt',
        'bundleId','bundleSize','bundleIndex','quoteNumber','quoteTotal'])
        && data.get('category','') is string && data.get('category','').size() <= 80
        && data.item is string && data.item.size() > 0 && data.item.size() <= 160
        && data.specification is string && data.specification.size() > 0 && data.specification.size() <= 1000
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000000
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 30
        && data.department is string && data.department.size() > 0 && data.department.size() <= 120
        && data.destination is string && data.destination.size() > 0 && data.destination.size() <= 160
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000
        && data.neededBy is string && data.neededBy.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.requesterId is string && data.requesterId.size() > 0
        && data.requesterName is string && data.requesterName.size() > 0
        && data.status in ['requested','approved','quotation','ordered','in_transit','received','exception','stored','delivered','finance_dispute','closed','rejected','cancelled']
        && data.get('createdAt',0) is int
        && validPurchaseWorkflow(data)
        && data.get('approvedBy','') is string && data.get('approvedAt',0) is int
        && data.get('buyerConfirmedBy','') is string && data.get('buyerConfirmedAt',0) is int
        && data.get('receiverConfirmedBy','') is string && data.get('receiverConfirmedAt',0) is int
        && data.get('invoiceReceivedBy','') is string && data.get('invoiceReceivedAt',0) is int
        && data.get('recipientConfirmedBy','') is string && data.get('recipientConfirmedAt',0) is int
        && data.get('financeConfirmedBy','') is string && data.get('financeConfirmedAt',0) is int;
    }
    function validPurchaseWorkflow(data) {
      return validPurchaseWorkflowFields(data) && validPurchaseParticipants(data);
    }
    function validPurchaseWorkflowFields(data) {
      return data.updatedAt is int && data.updatedBy is string
        && data.history is list && data.history.size() > 0 && data.history.size() <= 50
        && data.quotedPrice is number && data.quotedPrice >= 0
        && data.get('quoteTotal',0) is number && data.get('quoteTotal',0) >= 0
        && (data.get('quoteNumber','') == '' || data.quotedPrice == 0 || data.get('quoteTotal',0) >= data.quotedPrice * data.quantity)
        && data.get('quoteNumber','') is string && data.get('quoteNumber','').size() <= 40
        && data.get('invoiceTotal',0) is number && data.get('invoiceTotal',0) >= 0
        && data.receivedQuantity is number && data.receivedQuantity >= 0 && data.receivedQuantity <= data.quantity
        && data.get('condition','pending') in ['pending','ok','damaged'];
    }
    function validFinanceReview(data) {
      return data.get('financeIssue','') is string && data.get('financeIssue','').size() <= 1000
        && data.get('financeIssueBy','') is string && data.get('financeIssueAt',0) is int
        && data.get('financeResolution','') is string && data.get('financeResolution','').size() <= 1000
        && data.get('financeResolutionBy','') is string && data.get('financeResolutionAt',0) is int;
    }
    function validPurchaseParticipants(data) {
      let version = data.get('workflowVersion',0);
      let participants = data.get('participantIds',[]);
      let buyer = data.get('buyerId','');
      let approver = data.get('approverId','');
      let receiver = data.get('receiverId','');
      let recipient = data.get('recipientId','');
      let finance = data.get('financeId','');
      return version is int && version in [0,2]
        && participants is list && participants.size() <= 10
        && (version != 2 || (data.requesterId in participants
          && (buyer == '' || buyer in participants)
          && (approver == '' || approver in participants)
          && (receiver == '' || receiver in participants)
          && (recipient == '' || recipient in participants)
          && (finance == '' || finance in participants)))
        && buyer is string && approver is string
        && receiver is string && recipient is string && finance is string;
    }
    function validPurchaseStage(data) {
      let stage = data.status;
      let step = {'requested':0, 'quotation':1, 'approved':2, 'ordered':3, 'in_transit':3,
        'received':4, 'exception':4, 'stored':5, 'delivered':6, 'finance_dispute':6, 'closed':7, 'rejected':0, 'cancelled':0}[stage];
      return step == 0 || (
        (step < 2 || (data.get('supplier','') is string && data.supplier.size() > 0
          && data.get('expectedDate','') is string && data.expectedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}') && data.quotedPrice > 0))
        && (step < 3 || (data.get('orderNumber','') is string && data.orderNumber.size() > 0))
        && (step < 4 || (data.get('invoiceNumber','') is string && data.invoiceNumber.size() > 0
          && data.receivedQuantity > 0 && data.condition != 'pending'))
        && (stage != 'received' || (data.receivedQuantity == data.quantity && data.condition == 'ok'))
        && (stage != 'exception' || (data.receivedQuantity < data.quantity || data.condition == 'damaged'))
        && (step < 5 || (data.receivedQuantity == data.quantity && data.condition == 'ok'
          && data.get('storageAddress','') is string && data.storageAddress.size() > 0))
        && (step < 6 || (data.get('destinationRecipient','') is string && data.destinationRecipient.size() > 0))
        && (data.get('workflowVersion',0) != 2 || (
          data.get('buyerId','') != ''
          && (step < 2 || (data.get('approverId','') != '' && data.get('approvedBy','') == data.approverId && data.get('approvedAt',0) > 0))
          && (step < 3 || (data.get('buyerConfirmedBy','') == data.buyerId && data.get('buyerConfirmedAt',0) > 0))
          && (step < 4 || (data.get('receiverId','') != '' && data.get('receiverConfirmedBy','') == data.receiverId
            && data.get('receiverConfirmedAt',0) > 0 && data.get('invoiceReceivedBy','') == data.receiverId && data.get('invoiceReceivedAt',0) > 0))
          && (step < 6 || (data.get('recipientId','') != '' && data.get('recipientConfirmedBy','') == data.recipientId && data.get('recipientConfirmedAt',0) > 0))
          && (step < 7 || (data.get('financeId','') != '' && data.get('financeConfirmedBy','') == data.financeId && data.get('financeConfirmedAt',0) > 0))
        ))
      );
    }
    function validFinanceStage(data) {
      return data.status == 'finance_dispute'
        ? (data.get('financeIssue','') is string && data.financeIssue.size() > 0
          && data.get('financeIssueAt',0) > 0 && data.get('financeIssueBy','') == data.financeId
          && data.get('financeResolutionAt',0) == 0 && data.get('financeResolution','') == '')
        : (data.get('financeIssueAt',0) == 0 || (data.get('financeResolutionAt',0) > data.financeIssueAt
          && data.get('financeResolutionBy','') == data.receiverId));
    }
    function purchaseAuthority(app, company, data) {
      return (!exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval)
          || get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.get('preventSelfApproval',false) != true
          || (data.approverId != data.requesterId && data.approverId != data.buyerId))
        && (exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval)
        && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.get('enabled', false) == true
        ? data.approverId == ((data.get('quoteTotal',0) > 0 ? data.quoteTotal : data.quotedPrice * data.quantity) <= get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.threshold
          ? get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.lowerApproverId
          : get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/settings/purchase-approval).data.upperApproverId)
        : (exists(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(data.approverId))
          && get(/databases/$(database)/documents/artifacts/$(app)/public/data/companies/$(company)/users/$(data.approverId)).data.get('isAdmin', false) == true));
    }
    function purchaseAction(app, company, before, after) {
      let changed = after.diff(before).affectedKeys();
      let actor = request.auth.uid;
      let nextStage = after.status;
      return (!changed.hasAny(['buyerId']) || after.buyerId == '' || purchaseRoleAllowed(app, company, 'buyerIds', after.buyerId))
        && (!changed.hasAny(['supplier','quotedPrice','quoteTotal','expectedDate']) || purchaseRoleAllowed(app, company, 'buyerIds', actor))
        && (before.status == nextStage
        ? ((manages(app, company) && (before.status != 'closed' || changed.hasOnly(['note','updatedAt','updatedBy','history']))
          && (before.get('approvedAt',0) == 0 || !changed.hasAny(['supplier','quotedPrice','quoteTotal','expectedDate']))
          && (before.get('buyerConfirmedAt',0) == 0 || !changed.hasAny(['orderNumber']))
          && (before.get('invoiceReceivedAt',0) == 0 || !changed.hasAny(['invoiceNumber','invoiceTotal']))
          && !changed.hasAny(['financeIssue','financeIssueBy','financeIssueAt','financeResolution','financeResolutionBy','financeResolutionAt'])
          && !changed.hasAny(['approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt','invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt']))
          || (actor == before.get('buyerId','') && actor != '' && before.status in ['requested','quotation','approved','ordered','in_transit']
            && (before.get('approvedAt',0) == 0 || !changed.hasAny(['supplier','quotedPrice','quoteTotal','orderNumber','expectedDate']))
            && changed.hasOnly(['supplier','quotedPrice','quoteTotal','orderNumber','expectedDate','carrier','trackingCode','note','updatedAt','updatedBy','history']))
          || (actor == before.get('receiverId','') && actor != '' && before.status in ['ordered','in_transit','received','exception']
            && (before.get('invoiceReceivedAt',0) == 0 || !changed.hasAny(['invoiceNumber','invoiceTotal']))
            && changed.hasOnly(['invoiceNumber','invoiceTotal','receivedQuantity','condition','lot','expiresAt','storageAddress','note','updatedAt','updatedBy','history'])))
        : (!changed.hasAny(['buyerId','approverId','receiverId','recipientId','financeId','participantIds'])
          && ((nextStage == 'rejected' && manages(app, company) && changed.hasOnly(['status','note','updatedAt','updatedBy','history'])
              && changed.hasAny(['note']) && after.note is string && after.note.size() > 0)
            || (nextStage == 'cancelled' && manages(app, company) && changed.hasOnly(['status','note','updatedAt','updatedBy','history']))
            || (nextStage == 'requested' && before.status == 'rejected' && manages(app, company)
              && changed.hasOnly(['status','updatedAt','updatedBy','history']))
            || (nextStage == 'quotation' && actor == before.get('buyerId','') && actor != '' && purchaseRoleAllowed(app, company, 'buyerIds', actor) && changed.hasOnly(['status','updatedAt','updatedBy','history','supplier','quotedPrice','quoteTotal','orderNumber','expectedDate','carrier','trackingCode','note']))
            || (nextStage == 'approved' && before.get('bundleId','') == '' && actor == before.get('approverId','') && actor != '' && purchaseAuthority(app, company, after)
              && after.get('approvedBy','') == actor && after.get('approvedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','approvedBy','approvedAt']))
            || (nextStage == 'ordered' && actor == before.get('buyerId','') && actor != '' && before.get('approvedAt',0) > 0
              && after.get('buyerConfirmedBy','') == actor && after.get('buyerConfirmedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','orderNumber','carrier','trackingCode','note','buyerConfirmedBy','buyerConfirmedAt']))
            || (nextStage == 'in_transit' && actor == before.get('buyerId','') && actor != ''
              && changed.hasOnly(['status','updatedAt','updatedBy','history','carrier','trackingCode','note']))
            || (nextStage in ['received','exception'] && actor == before.get('receiverId','') && actor != ''
              && after.get('receiverConfirmedBy','') == actor && after.get('receiverConfirmedAt',0) == after.updatedAt
              && after.get('invoiceReceivedBy','') == actor && after.get('invoiceReceivedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','invoiceNumber','invoiceTotal','receivedQuantity','condition','lot','expiresAt','storageAddress','note','receiverConfirmedBy','receiverConfirmedAt','invoiceReceivedBy','invoiceReceivedAt']))
            || (nextStage == 'stored' && actor == before.get('receiverId','') && actor != ''
              && changed.hasOnly(['status','updatedAt','updatedBy','history','storageAddress','lot','expiresAt','note']))
            || (nextStage == 'delivered' && before.status == 'stored' && actor == before.get('recipientId','') && actor != ''
              && after.get('recipientConfirmedBy','') == actor && after.get('recipientConfirmedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','destinationRecipient','recipientConfirmedBy','recipientConfirmedAt']))
            || (nextStage == 'closed' && actor == before.get('financeId','') && actor != ''
              && after.get('financeConfirmedBy','') == actor && after.get('financeConfirmedAt',0) == after.updatedAt
              && changed.hasOnly(['status','updatedAt','updatedBy','history','financeConfirmedBy','financeConfirmedAt'])))));
    }
    // Closing changes only the Financeiro's proof. The delivered document has
    // already passed every preceding stage, so avoid re-evaluating that entire
    // history and exceeding the Firestore expression budget.
    function validPurchaseClose(app, company, before, after) {
      let actor = request.auth.uid;
      let changed = after.diff(before).affectedKeys();
      let history = after.history;
      let last = history[history.size() - 1];
      return (support() || (member(company) && integraEnabled(app, company)))
        && before.get('workflowVersion',0) == 2 && before.status == 'delivered' && after.status == 'closed'
        && actor == before.get('financeId','') && actor != ''
        && changed.hasOnly(['status','updatedAt','updatedBy','history','invoiceTotal','financeConfirmedBy','financeConfirmedAt'])
        && before.get('buyerConfirmedAt',0) > 0 && before.get('receiverConfirmedAt',0) > 0
        && before.get('invoiceReceivedAt',0) > 0 && before.get('recipientConfirmedAt',0) > 0
        && (before.get('financeIssueAt',0) == 0 || (before.get('financeResolutionAt',0) > before.financeIssueAt
          && before.get('financeResolutionBy','') == before.receiverId))
        && after.get('invoiceTotal',0) is number && after.invoiceTotal > 0
        && after.invoiceTotal >= before.quotedPrice * before.quantity - 0.01
        && after.invoiceTotal <= before.quotedPrice * before.quantity + 0.01
        && after.updatedAt is int && after.updatedAt > before.updatedAt && after.updatedBy == actor
        && after.financeConfirmedBy == actor && after.financeConfirmedAt == after.updatedAt
        && history is list && history.size() > 0 && history.size() <= 50
        && last.get('by','') == actor && last.get('stage','') == 'closed';
    }
    function validPurchaseDelivery(app, company, before, after) {
      let actor = request.auth.uid;
      let changed = after.diff(before).affectedKeys();
      let history = after.history;
      let last = history[history.size() - 1];
      return member(company) && integraEnabled(app,company)
        && before.get('workflowVersion',0) == 2 && before.status == 'stored' && after.status == 'delivered'
        && actor == before.get('recipientId','') && actor != ''
        && changed.hasOnly(['status','updatedAt','updatedBy','history','destinationRecipient','recipientConfirmedBy','recipientConfirmedAt'])
        && after.get('destinationRecipient','') is string && after.destinationRecipient.size() > 0 && after.destinationRecipient.size() <= 160
        && before.get('buyerConfirmedAt',0) > 0 && before.get('receiverConfirmedAt',0) > 0
        && before.get('invoiceReceivedAt',0) > 0
        && after.get('recipientConfirmedBy','') == actor && after.get('recipientConfirmedAt',0) == after.updatedAt
        && after.updatedAt is int && after.updatedAt > before.updatedAt && after.updatedBy == actor
        && history is list && history.size() > 0 && history.size() <= 50
        && last.get('by','') == actor && last.get('stage','') == 'delivered';
    }
    function validFinanceReviewUpdate(app, company, before, after) {
      let actor = request.auth.uid;
      let changed = after.diff(before).affectedKeys();
      let history = after.history;
      let last = history[history.size() - 1];
      return (support() || (member(company) && integraEnabled(app, company)))
        && before.get('workflowVersion',0) == 2
        && after.updatedAt is int && after.updatedAt > before.updatedAt && after.updatedBy == actor
        && history is list && history.size() > 0 && history.size() <= 50
        && last.get('by','') == actor && last.get('stage','') == after.status
        && (after.status == 'finance_dispute'
          ? (before.status == 'delivered' && actor == before.get('financeId','') && actor != ''
            && changed.hasOnly(['status','updatedAt','updatedBy','history','invoiceTotal','financeIssue','financeIssueBy','financeIssueAt',
              'financeResolution','financeResolutionBy','financeResolutionAt'])
            && after.get('financeIssue','') is string && after.financeIssue.size() > 0 && after.financeIssue.size() <= 1000
            && after.get('financeIssueBy','') == actor && after.get('financeIssueAt',0) == after.updatedAt
            && after.get('financeResolution','') == '' && after.get('financeResolutionBy','') == '' && after.get('financeResolutionAt',0) == 0)
          : (before.status == 'finance_dispute' && after.status == 'delivered'
            && actor == before.get('receiverId','') && actor != '' && before.get('financeIssueAt',0) > 0
            && changed.hasOnly(['status','updatedAt','updatedBy','history','invoiceNumber','invoiceTotal','financeResolution','financeResolutionBy','financeResolutionAt',
              'receiverConfirmedBy','receiverConfirmedAt','invoiceReceivedBy','invoiceReceivedAt'])
            && after.get('invoiceNumber','') is string && after.invoiceNumber.size() > 0 && after.invoiceNumber.size() <= 80
            && after.get('invoiceTotal',0) is number && after.invoiceTotal >= 0
            && after.get('financeResolution','') is string && after.financeResolution.size() > 0 && after.financeResolution.size() <= 1000
            && after.get('financeResolutionBy','') == actor && after.get('financeResolutionAt',0) == after.updatedAt
            && after.get('receiverConfirmedBy','') == actor && after.get('receiverConfirmedAt',0) == after.updatedAt
            && after.get('invoiceReceivedBy','') == actor && after.get('invoiceReceivedAt',0) == after.updatedAt));
    }
    function validPurchaseUpdate(app, company, before, after) {
      let changed = after.diff(before).affectedKeys();
      let history = after.history;
      let last = history[history.size() - 1];
      return (before.status == 'finance_dispute' || after.status == 'finance_dispute')
        ? validFinanceReviewUpdate(app, company, before, after)
        : before.status == 'delivered' && after.status == 'closed'
        ? validPurchaseClose(app, company, before, after)
        : before.status == 'stored' && after.status == 'delivered'
        ? validPurchaseDelivery(app,company,before,after)
        : (support() || (member(company) && integraEnabled(app, company)))
          && after.get('workflowVersion',0) == 2
          && purchaseStageChange(before.get('status',''), after.status)
          && changed.hasOnly([
            'supplier','quotedPrice','quoteTotal','orderNumber','expectedDate','carrier','trackingCode','invoiceNumber','invoiceTotal','receivedQuantity',
            'condition','lot','expiresAt','storageAddress','destinationRecipient','note','status','updatedAt','updatedBy','history',
            'buyerId','approverId','receiverId','recipientId','financeId','participantIds',
            'approvedBy','approvedAt','buyerConfirmedBy','buyerConfirmedAt','receiverConfirmedBy','receiverConfirmedAt',
            'invoiceReceivedBy','invoiceReceivedAt','recipientConfirmedBy','recipientConfirmedAt','financeConfirmedBy','financeConfirmedAt',
            'financeIssue','financeIssueBy','financeIssueAt','financeResolution','financeResolutionBy','financeResolutionAt'])
          && purchaseAction(app, company, before, after)
          // Immutable request fields were validated at creation or migration.
          // Revalidate only editable workflow fields to stay below the expression limit.
          && validPurchaseWorkflowFields(after) && validPurchaseStage(after)
          && (!(after.status == 'finance_dispute' || (after.get('financeIssueAt',0) > 0 && after.status in ['delivered','closed'])) || validFinanceStage(after))
          && (!changed.hasAny(['financeIssue','financeIssueBy','financeIssueAt','financeResolution','financeResolutionBy','financeResolutionAt']) || validFinanceReview(after))
          && (!changed.hasAny(['buyerId','approverId','receiverId','recipientId','financeId','participantIds']) || validPurchaseParticipants(after))
          && after.updatedBy == request.auth.uid
