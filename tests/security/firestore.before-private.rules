rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToCompany(companyId) {
      return signedIn() && request.auth.token.companyId == companyId;
    }

    function isPlatformSupport() {
      return signedIn() && request.auth.token.isDeveloper == true;
    }

    match /artifacts/{appId}/public/data/companies/{companyId} {
      allow read: if belongsToCompany(companyId) || isPlatformSupport();
      allow write: if false;

      match /{document=**} {
        allow read, write: if belongsToCompany(companyId) || isPlatformSupport();
      }
    }
  }
}
